# Use index.php or index.html as directory index
DirectoryIndex index.php index.html

# Force HTTPS + canonical host
RewriteEngine On

# If not HTTPS, redirect
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Optional: force bare domain (no www). Comment out if host handles it.
RewriteCond %{HTTP_HOST} ^www\.cpaykg\.ca$ [NC]
RewriteRule ^(.*)$ https://cpaykg.ca/$1 [L,R=301]

# Basic caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

# Gzip compression where available
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json
</IfModule>